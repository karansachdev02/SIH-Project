PORT=5000
MONGODB_URI=mongodb://localhost:27017/smartmandi
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
NODE_ENV=development
OTP_EXPIRY_MINUTES=5
MOBILE_VERIFICATION_TOKEN_EXPIRES_IN=10m

# ── Admin Seed Script (npm run create:admin) ──────────────────────────────────
# Required only when running the admin seed script. Never committed to version control.
ADMIN_MOBILE=9000000001
ADMIN_PASSWORD=your_admin_password_here
ADMIN_NAME=Smart Mandi Admin

# ── Mandi / Market Price API (data.gov.in) ────────────────────────────────────
# Obtain a free API key at: https://data.gov.in/user/register
# This key is used SERVER-SIDE ONLY to fetch commodity market prices.
#
# ⚠️  SECURITY RULES — READ CAREFULLY:
#   • This key belongs ONLY in server/.env — NEVER in client/.env
#   • Never hardcode the real key anywhere in source code
#   • Never commit server/.env to version control
#   • The key is NEVER returned to the frontend in any API response
#   • The key is NEVER logged to console
#
# If this key is missing, the server returns static sample/fallback data automatically.
# The application works without this key — real government data is only fetched when configured.
DATA_GOV_API_KEY=your_data_gov_api_key_here

# data.gov.in resource ID for "Current Daily Price of Various Commodities"
# Default value shown below. Store here so it can be updated without code changes
# if data.gov.in changes the resource ID in future.
DATA_GOV_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# ── AI Price Prediction (Gemini — optional) ───────────────────────────────────
# When present, enables Gemini-1.5-Flash powered price predictions.
# Without this key, the server uses a statistical fallback engine automatically.
# Obtain a free key at: https://aistudio.google.com/
#
# ⚠️  SECURITY RULES:
#   • This key belongs ONLY in server/.env — NEVER in client/.env
#   • Never hardcode in source code, never commit .env to version control
#   • Never return this key to the frontend in any response
#   • Never log this key
GEMINI_API_KEY=your_gemini_api_key_here
